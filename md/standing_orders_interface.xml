<?xml version="1.0" encoding="utf-8"?>
<mdscript name="Standing_Orders_Interface" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <cues>

    <cue name="Main" version="4">
      <actions>
        <include_actions ref="ReadDebugChances" />
        <debug_text text="'StandingOrders: Main'" chance="$debugChance" filter="scripts" />
        <include_actions ref="ClearDebugChances" />
        <set_value name="$sourceShipForCloning" exact="null" />
      </actions>
      <cues>
        <!-- $debugChance for one line per action, $traceChance for per-item detail. Callers must include
             ClearDebugChances when done. -->
        <library name="ReadDebugChances" purpose="include_actions">
          <actions>
            <set_value name="$soDebugLevel" exact="if @player.entity.$StandingOrdersConfig.$debugLevel != null
              then player.entity.$StandingOrdersConfig.$debugLevel else 'none'" />
            <set_value name="$debugChance" exact="if @$soDebugLevel == null or @$soDebugLevel == 'none' then 0 else 100" />
            <set_value name="$traceChance" exact="if @$soDebugLevel == 'trace' then 100 else 0" />
            <remove_value name="$soDebugLevel" />
          </actions>
        </library>

        <library name="ClearDebugChances" purpose="include_actions">
          <actions>
            <remove_value name="$debugChance" />
            <remove_value name="$traceChance" />
          </actions>
        </library>

        <library name="Defaults" purpose="include_actions">
          <actions>
            <set_value name="$cfg" exact="table[
              $debugLevel = 'none',
            ]" />
          </actions>
        </library>

        <!-- A stored source can silently stop being one: sold (owner changes, then MoveDie destroys it),
             destroyed, boarded or wrecked. Nothing else clears it, so re-check before every use. -->
        <library name="Validate_Source" purpose="include_actions">
          <actions>
            <do_if value="@$sourceShipForCloning != null">
              <do_if value="@$sourceShipForCloning.exists and
                            @$sourceShipForCloning.isclass.{class.ship} and
                            @$sourceShipForCloning.trueowner == faction.player and
                            @$sourceShipForCloning.isoperational and
                            not @$sourceShipForCloning.iswreck" negate="true">
                <debug_text text="'StandingOrders: stored source %s is no longer valid - clearing it'.[@$sourceShipForCloning.debugname]"
                  chance="$debugChance" filter="scripts" />
                <set_value name="$sourceShipForCloning" exact="null" />
              </do_if>
            </do_if>
          </actions>
        </library>

        <cue name="On_Reload" version="2" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'StandingOrders'" control="'Reloaded'" />
          </conditions>
          <actions>
            <include_actions ref="ReadDebugChances" />
            <debug_text text="'StandingOrders: On_Reload'" chance="$debugChance" filter="scripts" />
            <include_actions ref="ClearDebugChances" />
            <signal_cue_instantly cue="Reloaded" />
          </actions>
        </cue>

        <cue name="On_Game_Loaded" version="2" instantiate="true">
          <conditions>
            <event_game_loaded />
          </conditions>
          <actions>
            <include_actions ref="ReadDebugChances" />
            <debug_text text="'StandingOrders: On_Game_Loaded'" chance="$debugChance" filter="general" />
            <include_actions ref="ClearDebugChances" />
            <signal_cue_instantly cue="Reloaded" />
          </actions>
        </cue>

        <cue name="Reloaded" version="2" instantiate="true">
          <conditions>
            <event_cue_signalled />
          </conditions>
          <actions>
            <include_actions ref="ReadDebugChances" />
            <debug_text text="'StandingOrders: Reloaded'" chance="$debugChance" filter="general" />
            <include_actions ref="ClearDebugChances" />
            <set_value name="$sourceShipForCloning" exact="null" />
          </actions>
        </cue>

        <cue name="On_Get_Actions" version="3" instantiate="true">
          <conditions>
            <event_cue_signalled cue="md.Interact_Menu_API.Get_Actions" />
            <!-- Conditions cannot run include_actions, so the trace level is read inline here. -->
            <debug_text text="'StandingOrders: Get_Actions invoked with param: %s'.[event.param]"
              debugchance="if @player.entity.$StandingOrdersConfig.$debugLevel == 'trace' then 100 else 0" filter="scripts" />
            <debug_text text="'StandingOrders: Get_Actions invoked with object: %s'.[@event.param.$object.debugname]"
              debugchance="if @player.entity.$StandingOrdersConfig.$debugLevel == 'trace' then 100 else 0" filter="scripts" />
            <check_value value="player.holomap.isopen" />
            <check_value value="event.param.$object? and @event.param.$object != null" />
            <debug_text text="'StandingOrders: Get_Actions invoked with object.class: %s'.[@event.param.$object.class]"
              debugchance="if @player.entity.$StandingOrdersConfig.$debugLevel == 'trace' then 100 else 0" filter="scripts" />
            <check_value value="@event.param.$object.isclass.{class.ship}" />
            <check_value value="@event.param.$object.trueowner == faction.player" />
            <check_value value="@event.param.$object.isoperational" />
            <check_value value="@event.param.$object.iswreck" negate="true" />
          </conditions>
          <actions>
            <include_actions ref="ReadDebugChances" />
            <include_actions ref="Validate_Source" />
            <set_value name="$params" exact="@event.param" />
            <debug_text
              text="'StandingOrders: sourceShipForCloning: %s, selectedplayerships.count: %s'.[@$sourceShipForCloning.debugname, @$params.$selectedplayerships.count]"
              chance="$traceChance" filter="scripts" />
            <do_if value="@$sourceShipForCloning == null">
              <debug_text text="'StandingOrders: Updating interaction menu actions to add Source Selection'" chance="$traceChance"
                filter="scripts" />
              <do_if value="@$params.$selectedplayerships.count gt 0" negate="true">
                <signal_cue_instantly
                  cue="md.Interact_Menu_API.Add_Action"
                  param="table[
                  $id         = 'player_standing_orders_select_source',
                  $section    = 'interaction',
                  $text       = '[&#8734;]: %s'.[{1972092408, 10101}],
                  $mouseover  = '[%s]: %s'.[{1972092408, 1}, {1972092408, 10101}],
                  $icon       = 'menu_export',
                  $active     = true,
                  $callback   =  Process_Menu
                ]" />
              </do_if>
            </do_if>
            <do_elseif value="@$sourceShipForCloning == @event.param.$object">
              <debug_text text="'StandingOrders: Updating interaction menu actions to add Deselect Source Selection'" chance="$traceChance"
                filter="scripts" />
              <do_if value="@$params.$selectedplayerships.count gt 0" negate="true">
                <signal_cue_instantly
                  cue="md.Interact_Menu_API.Add_Action"
                  param="table[
                  $id         = 'player_standing_orders_deselect_source',
                  $section    = 'interaction',
                  $text       = '[&#8734;]: %s'.[{1972092408, 10201}],
                  $mouseover  = '[%s]: %s'.[{1972092408, 1}, {1972092408, 10201}],
                  $icon       = 'menu_reset',
                  $active     = true,
                  $callback   =  Process_Menu
                ]" />
              </do_if>
            </do_elseif>
            <do_else>
              <debug_text text="'StandingOrders: Source selected is different from current source. Can be a target for cloning.'" chance="$traceChance"
                filter="scripts" />
              <set_value name="$sourceFullName" exact="@$sourceShipForCloning.name + ' (' + @$sourceShipForCloning.idcode + ')'" />
              <set_value name="$menuSection" exact="'interaction'" />
              <do_if value="@$params.$selectedplayerships.count gt 0">
                <set_value name="$menuSection" exact="'trade_orders'" />
              </do_if>
              <signal_cue_instantly
                cue="md.Interact_Menu_API.Add_Action"
                param="table[
                  $id         = 'player_standing_orders_clone',
                  $section    = $menuSection,
                  $text       = '[&#8734;]: %s'.[{1972092408, 10301}.[@$sourceFullName]],
                  $mouseover  = '[%s]: %s'.[{1972092408, 1}, {1972092408, 10301}.[@$sourceFullName]],
                  $icon       = 'menu_import',
                  $active     = true,
                  $callback   =  Process_Menu
                ]" />
              <!-- Also offered here so the source is reachable without flying back to it. -->
              <signal_cue_instantly
                cue="md.Interact_Menu_API.Add_Action"
                param="table[
                  $id         = 'player_standing_orders_deselect_source',
                  $section    = $menuSection,
                  $text       = '[&#8734;]: %s'.[{1972092408, 10201}],
                  $text2      = @$sourceFullName,
                  $mouseover  = '[%s]: %s - %s'.[{1972092408, 1}, @$sourceFullName, {1972092408, 10201}],
                  $icon       = 'menu_reset',
                  $active     = true,
                  $callback   =  Process_Menu
                ]" />
            </do_else>
            <include_actions ref="ClearDebugChances" />
          </actions>
        </cue>

        <cue name="Process_Menu" version="4" instantiate="true">
          <conditions>
            <event_cue_signalled />
          </conditions>
          <actions>
            <include_actions ref="ReadDebugChances" />
            <debug_text text="'StandingOrders: Process_Menu invoked with param: %s'.[event.param]" chance="$traceChance" filter="scripts" />
            <include_actions ref="Validate_Source" />
            <set_value name="$args" exact="null" />
            <do_if value="@event.param.$id == 'player_standing_orders_select_source' or @event.param.$id == 'player_standing_orders_deselect_source'">
              <!-- Built before clearing: a deselect raised from another ship must still name the stored source. -->
              <set_value name="$args"
                exact="table[
                  $command            = if @event.param.$id == 'player_standing_orders_select_source' then 'mark_source' else 'unmark_source',
                  $source             = if @event.param.$id == 'player_standing_orders_select_source' then @event.param.$object else @$sourceShipForCloning,
                ]" />
              <set_value name="$sourceShipForCloning" exact="null" />
              <debug_text text="'StandingOrders: Deselected source for cloning. Current source: %s'.[@$sourceShipForCloning.debugname]"
                chance="$debugChance" filter="scripts" />
            </do_if>
            <do_elseif value="@event.param.$id == 'player_standing_orders_clone'">
              <do_if value="@$sourceShipForCloning != null">
                <create_list name="$targetList" />
                <append_to_list name="$targetList" exact="@event.param.$object" />
                <do_if value="@$params.$selectedplayerships.count gt 0">
                  <do_for_each name="$ship" in="@$params.$selectedplayerships">
                    <!-- Each selected ship is checked on its own, and the source can never be a target of itself. -->
                    <do_if
                      value="@$ship != @event.param.$object and
                      @$ship != @$sourceShipForCloning and
                      @$ship.isclass.{class.ship} and
                      @$ship.trueowner == faction.player and
                      @$ship.isoperational and
                      not @$ship.iswreck">
                      <append_to_list name="$targetList" exact="@$ship" />
                    </do_if>
                  </do_for_each>
                </do_if>
                <set_value name="$args"
                  exact="table[
                    $command            = 'clone_orders',
                    $source             = @$sourceShipForCloning,
                    $targets            = $targetList,
                  ]" />
                <debug_text
                  text="'StandingOrders: Prepared clone_orders with source: %s and target: %s'.[@$sourceShipForCloning.debugname, @event.param.$object.debugname]"
                  chance="$debugChance" filter="scripts" />
              </do_if>
            </do_elseif>
            <do_if value="$args != null">
              <do_if value="not player.entity.$StandingOrdersRequest?">
                <set_value name="player.entity.$StandingOrdersRequest" exact="[]" />
              </do_if>
              <append_to_list name="player.entity.$StandingOrdersRequest" exact="$args" />
              <debug_text
                text="'StandingOrders: Sending %s with args: %s'.[$args.$command, $args]"
                chance="$traceChance" filter="scripts" />
              <raise_lua_event name="'StandingOrders.Request'" />
            </do_if>
            <include_actions ref="ClearDebugChances" />
          </actions>
        </cue>

        <cue name="Process_Results" version="2" instantiate="true">
          <conditions>
            <event_ui_triggered screen="'StandingOrders'" control="'Response'" />
          </conditions>
          <actions>
            <include_actions ref="ReadDebugChances" />
            <debug_text text="'StandingOrders: Capture_Results invoked with data in $StandingOrdersResponse: %s'.[player.entity.$StandingOrdersResponse]"
              chance="$traceChance" filter="scripts" />
            <!--Look
            up the action by id to get the callback.-->
            <set_value name="$result" exact="@player.entity.$StandingOrdersResponse" />
            <debug_text text="'StandingOrders: Process_Results invoked with result: %s'.[$result]" chance="$traceChance" filter="scripts" />
            <do_if value="$result? and @$result != null">
              <debug_text text="'StandingOrders: last command %s result: %s'.[@$result.$command, $result]" chance="$debugChance" filter="scripts" />
              <do_if value="@$result.$command == 'mark_source' and @$result.$source != null">
                <do_if value="@$result.$result == 'success' and @$result.$source != null">
                  <set_holomap_target object="@$result.$source" instant="true" />
                  <set_value name="$sourceShipForCloning" exact="@$result.$source" />
                  <debug_text text="'StandingOrders: Marked source for cloning: %s'.[@$sourceShipForCloning.debugname]" chance="$debugChance"
                    filter="scripts" />
                </do_if>
              </do_if>
              <do_elseif value="@$result.$command == 'unmark_source' and @$result.$source != null">
                <do_if value="@$result.$result == 'success'">
                  <set_value name="$sourceShipForCloning" exact="null" />
                  <debug_text text="'StandingOrders: Unmarked source for cloning. Current source: %s'.[@$sourceShipForCloning.debugname]"
                    chance="$debugChance" filter="scripts" />
                </do_if>
              </do_elseif>
            </do_if>
            <include_actions ref="ClearDebugChances" />
          </actions>
        </cue>
      </cues>
    </cue>
  </cues>
</mdscript>